# Local development only. Copy to .env, which is ignored by Git.
# Never put a production value in this file and never commit a real secret.
TA_HELP_DESK_ENV=development
TA_HELP_DESK_PORT=8080
TA_HELP_DESK_SESSION_SECRET=replace-with-a-long-local-random-value

# Serve the built client from the Java server on one origin. Leave unset to run
# the API alone and use the Vite dev server with its /api proxy instead.
# TA_HELP_DESK_STATIC_DIR=src/frontend/dist

# Required in production. Set these only in your shell/.env; never expose them to frontend code.
# TA_HELP_DESK_DATABASE_URL=jdbc:postgresql://localhost:5432/tahelpdesk
# TA_HELP_DESK_DATABASE_USER=tahelpdesk
# TA_HELP_DESK_DATABASE_PASSWORD=local-development-only
# TA_HELP_DESK_JDBC_JAR=.local-lib/postgresql.jar

# SOC API access
SOCLAAS_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
SOCLAAS_STAFF_API_KEY=""
SOCLAAS_STAFF_CHAT_MODEL=gemma4:26b
SOCLAAS_STAFF_FALLBACK_CHAT_MODEL=qwen3.5:9b
SOCLAAS_STUDENT_API_KEY=""

# Production values are set in the deployment platform, not here. See
# workflow/features/deployment/tasks.md for the full production contract.
